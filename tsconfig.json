{
  "compilerOptions": {
      "module": "commonjs",
      "esModuleInterop": true,
      "target": "es6",
      "outDir": "build",
      "rootDir": "src",
      "types": ["node", "jest"],
      "strict": false,
      "skipLibCheck": true,
      "sourceMap": true
  },
  "include": [
    "src/types.d.ts",
    "src/**/*"
  ],
  "exclude": [
    "test",
    "jest.config.ts",
    "node_modules",
    "build"
  ]
}
